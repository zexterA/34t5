# Copy to .env (never commit it). Real ids only; the zeros below are placeholders.

# --- accounts, option A: referenced from config.json via "token_env" ---
VK_TOKEN_MAIN=
VK_TOKEN_ALT=

# --- accounts, option B: no config.json at all (env-only mode) ---
# VK_TOKENS=token1,token2
# VK_GUILD_ID=000000000000000000
# VK_CHANNEL_ID=000000000000000000
# VK_SELF_MUTE=false
# VK_SELF_DEAF=false
# VK_SELF_VIDEO=false
# VK_SELF_STREAM=false

# --- optional control bot (official bot token, slash commands) ---
# VK_BOT_TOKEN=
# VK_OWNER_IDS=000000000000000000        # comma separated user ids allowed to use /vk
# VK_COMMAND_GUILD_IDS=000000000000000000  # optional: register commands instantly in these servers

# --- optional ---
# VK_CONFIG=config.json
# VK_STATE_PATH=state.json
# VK_LOG_LEVEL=INFO
# VK_HEALTH_PORT=8080
# VK_HEALTH_HOST=0.0.0.0
